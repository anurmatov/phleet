# Managed stock OpenShell gateway (#492) — example only. Keys follow the pinned upstream schema
# (NVIDIA/OpenShell bdb956f2cd65a635f1294fccf1d138d263bf650f, docs/how-it-works/gateways/configuration.mdx).
# Unlike upstream's local sample this keeps TLS on, refuses unauthenticated users and pins images
# by digest. Replace every <placeholder>; never copy the insecure upstream sample or :latest tags.
# Mount read-only into the gateway unit and clear the image's default CMD.

[openshell]
version = 2

[openshell.gateway]
# Container listener. Compose attaches it to fleet-net, where the orchestrator's stock CLI reaches
# https://openshell-gateway:8443 over mTLS, and publishes it only as 127.0.0.1:8443 on the host, where
# the trusted host-network supervisor calls back to https://127.0.0.1:8443. The server cert must carry
# the openshell-gateway DNS SAN and the 127.0.0.1 IP SAN. Never a public (0.0.0.0) host interface.
bind_address        = "0.0.0.0:8443"
health_bind_address = "127.0.0.1:8081"
log_level           = "info"
compute_driver      = "docker"
disable_tls         = false
# Required with TLS on and the Docker driver: the gateway-owned CA that issued gateway.pem (not
# client_ca_path). The gateway injects it into the Docker driver so the supervisor can authenticate the
# gateway's server certificate; the pinned stock gateway refuses guest TLS bootstrap without it. Keep it
# here, never in [openshell.drivers.docker], and omit it only when TLS is disabled.
guest_tls_ca        = "/var/lib/openshell/tls/ca.pem"

[openshell.gateway.tls]
cert_path      = "/var/lib/openshell/tls/gateway.pem"
key_path       = "/var/lib/openshell/tls/gateway-key.pem"
client_ca_path = "/var/lib/openshell/tls/client-ca.pem"

[openshell.gateway.gateway_jwt]
signing_key_path = "/var/lib/openshell/tls/jwt/signing.pem"
public_key_path  = "/var/lib/openshell/tls/jwt/public.pem"
kid_path         = "/var/lib/openshell/tls/jwt/kid"
gateway_id       = "<gateway-id>"

[openshell.gateway.auth]
allow_unauthenticated_users = false

[openshell.gateway.mtls_auth]
enabled = true
operator_enabled = true

[openshell.drivers.docker]
# Pin by digest. The workload image is the phleet stock-agent target; it is passed per sandbox.
sandbox_runtime_image = "<stock sandbox runtime image>@sha256:<digest>"
supervisor_image      = "<stock supervisor image>@sha256:<digest>"
image_pull_policy     = "if_not_present"

# #503 stock-memory signer registration: DORMANT until the signer runbook in docs/openshell-stock.md.
# Registering it makes the outside signer a hard startup dependency of THIS ENTIRE gateway. At every start and
# restart the gateway authenticates to every registered service (Describe/negotiation) and refuses to start when one
# is unavailable or incompatible (expired certificate, wrong CA, rejected JWT), for ALL sandboxes, managed or not.
# Uncomment it only inside a separately authorized maintenance window: quiesce every owned managed record, take S0,
# edit, take S1, re-verify BOTH, start the signer first and only then this gateway. Requirements:
#   - grpc_endpoint: one DNS name:port resolvable and reachable from BOTH this gateway container and the host-network
#     supervisors, served over HTTPS + HTTP/2 with that exact DNS SAN (no loopback or container-only alias);
#   - audience: exactly the outside managed-authority.json GatewayAudience, case included; never rely on the stock
#     default urn:openshell:extension:middleware:stock-memory;
#   - tls_ca_cert_path: the CA of the signer's server certificate, a regular file under STATE_DIR (here the default
#     /var/lib/openshell); gateway backups refuse a registration whose CA is missing, empty, linked or outside it;
#   - allow_insecure_transport stays false. The signer's private key stays in outside custody, never under STATE_DIR.
# [[openshell.supervisor.middleware]]
# name                     = "stock-memory"
# grpc_endpoint            = "https://identity.example.test:5443"
# audience                 = "<gateway-audience>"
# tls_ca_cert_path         = "/var/lib/openshell/tls/stock-identity-ca.pem"
# max_payload_bytes        = 262144
# timeout                  = "2s"
# allow_insecure_transport = false
