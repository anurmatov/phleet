<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Fleet.Comms</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fleet.Protocol\Fleet.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Argon2id is mandated by the contract for enrollment codes, device secrets and access tokens
      (docs/first-party-api.md §3). .NET ships no Argon2 implementation, so this is the one new
      dependency in the slice.
    -->
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />

    <!--
      The durable auth store. A file-backed engine with real transactions, so registrations,
      enrollment consumption and revocation survive a restart and are exercised by the ordinary
      test run rather than behind a conditional skip.

      10.0.12, not 10.0.5 like the sibling Microsoft.* pins: 10.0.5 resolves
      SQLitePCLRaw.lib.e_sqlite3 2.1.11, which carries GHSA-2m69-gcr7-jv3q (high). 10.0.12 brings
      2.1.12, and a transitive vulnerability scan of this project reports clean.
    -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Fleet.Comms.Tests" />
  </ItemGroup>

</Project>
