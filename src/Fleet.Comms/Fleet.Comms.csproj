<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Fleet.Comms</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fleet.Protocol\Fleet.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Argon2id is mandated by the contract for enrollment codes, device secrets and access tokens
      (docs/first-party-api.md §3). .NET ships no Argon2 implementation, so this is the one new
      dependency in the slice.
    -->
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Fleet.Comms.Tests" />
  </ItemGroup>

</Project>
