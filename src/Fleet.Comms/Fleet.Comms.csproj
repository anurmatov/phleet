<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Fleet.Comms</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fleet.Protocol\Fleet.Protocol.csproj" />
    <ProjectReference Include="..\Fleet.Conversations\Fleet.Conversations.csproj" />
    <!-- For Fleet.Shared.SignIn alone: the names sign-in shares with the orchestrator. -->
    <ProjectReference Include="..\Fleet.Shared\Fleet.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The journal's read tools (#394): stateless streamable HTTP on the journal listener only.
      Pinned to the version Fleet.Telegram serves its tools with, so the fleet speaks one MCP SDK.
    -->
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Fleet.Comms.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fleet.Contracts\Fleet.Contracts.csproj" />
    <!-- The wire contracts are used throughout; see src/Fleet.Contracts. -->
    <Using Include="Fleet.Contracts" />
  </ItemGroup>

</Project>
