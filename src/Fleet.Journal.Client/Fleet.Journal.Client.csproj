<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Fleet.Journal.Client</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    The publisher half of the conversation journal (#377): classifier, local spool and drainer.

    It references Fleet.Conversations.Contracts and NOTHING that reaches a database. The agent
    holds no journal database credential; everything it writes goes through the Comms journal
    listener over HTTP. ContractsDependencyTests asserts Fleet.Agent never references
    Fleet.Conversations, and this project is one of the ways it could have.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Fleet.Conversations.Contracts\Fleet.Conversations.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.5" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Fleet.Journal.Client.Tests" />
    <InternalsVisibleTo Include="Fleet.Agent.Tests" />
  </ItemGroup>

</Project>
