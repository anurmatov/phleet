<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Fleet.Orchestrator</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fleet.Shared\Fleet.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Fleet.Orchestrator.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Content Include="roles\**\*" CopyToPublishDirectory="PreserveNewest" />
    <!-- Built-in output styles are product content shipped in the image, unlike roles/, which the
         operator supplies. They are seeded into output_styles on startup. -->
    <Content Include="OutputStyles\**\*.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="credentials-registry.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Argon2id for sign-in credentials at rest (Auth/). Framework cryptography has no Argon2id. -->
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" />
    <PackageReference Include="RabbitMQ.Client" />
    <PackageReference Include="Temporalio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fleet.Contracts\Fleet.Contracts.csproj" />
    <!-- The wire contracts are used throughout; see src/Fleet.Contracts. -->
    <Using Include="Fleet.Contracts" />
  </ItemGroup>

</Project>
