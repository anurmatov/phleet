<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Fleet.Orchestrator</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fleet.Shared\Fleet.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Fleet.Orchestrator.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Content Include="roles\**\*" CopyToPublishDirectory="PreserveNewest" />
    <!-- Built-in output styles are product content shipped in the image, unlike roles/, which the
         operator supplies. They are seeded into output_styles on startup. -->
    <Content Include="OutputStyles\**\*.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="credentials-registry.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.26.1" />
    <PackageReference Include="Grpc.Net.Client" Version="2.67.0" />
    <PackageReference Include="Grpc.Tools" Version="2.67.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.3">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="ModelContextProtocol" Version="0.8.0-preview.1" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="0.8.0-preview.1" />
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0" />
    <PackageReference Include="RabbitMQ.Client" Version="7.1.2" />
    <PackageReference Include="Temporalio" Version="1.11.1" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="OpenShell/Proto/*.proto" ProtoRoot="OpenShell/Proto" GrpcServices="Client" Exclude="OpenShell/Proto/extension.proto;OpenShell/Proto/supervisor_middleware.proto" />
    <!-- Messages only: the preflight reads recorded replies and never calls a middleware gRPC.
         Fleet.Identity exports the same generated types publicly; consumers that reference both
         assemblies alias this one (see Fleet.Identity.Tests). -->
    <Protobuf Include="OpenShell/Proto/extension.proto;OpenShell/Proto/supervisor_middleware.proto" ProtoRoot="OpenShell/Proto" GrpcServices="None" />
  </ItemGroup>
</Project>
