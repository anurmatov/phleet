{
  "Docker": {
    "SocketPath": "/var/run/docker.sock"
  },
  "ConnectionStrings": {
    "OrchestratorDb": ""
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:3600"
      }
    }
  },
  "RabbitMq": {
    "Host": "",
    "Exchange": "fleet.orchestrator"
  },
  "Temporal": {
    "Address": "",
    "Namespaces": [ "fleet" ],
    "PollIntervalSeconds": 15
  },
  "Orchestrator": {
    "AuthToken": ""
  },
  "Provisioning": {
    "EnvFilePath": "/app/deploy/.env",
    "DefaultNetwork": "fleet-net",
    "AgentImage": "fleet:agent"
  },
  "FleetMemory": {
    "Url": "http://fleet-memory:3100",
    "McpUrl": "http://fleet-memory:3100"
  },
  "Journal": {
    "StatusUrl": "http://fleet-comms:8083/journal/v1/status",
    "TokenKey": "",
    "ExcludedChatIds": ""
  },
  "WorkflowOutcomes": {
    "Enabled": false,
    "Namespaces": "",
    "PollSeconds": 30,
    "RecentScanSeconds": 60,
    "FullScanSeconds": 300,
    "BatchSeconds": 30,
    "BatchSize": 20,
    "OwnersFile": "",
    "ClassifiersFile": "",
    "KeyringDir": "",
    "CoordinatorTokenKey": "FLEET_WORKFLOW_OUTCOMES_COORDINATOR_TOKEN",
    "CoordinatorCredentialVersion": 1,
    "CoordinatorGeneration": 1,
    "CoordinatorBaseUrl": "",
    "UnackedAttentionMinutes": 15,
    "CauseUnresolvedAlertSeconds": 300,
    "ResolvedRetentionDays": 90
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
