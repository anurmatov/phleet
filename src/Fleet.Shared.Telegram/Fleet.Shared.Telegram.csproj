<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The types keep the namespace they had in Fleet.Shared, so no caller changed. -->
    <RootNamespace>Fleet.Shared</RootNamespace>
  </PropertyGroup>

  <!--
    The Telegram formatters, split out of Fleet.Shared so that referencing Fleet.Shared no longer
    brings Telegram.Bot with it. Only the two services that send Telegram messages reference this:
    the agent and fleet-telegram.
  -->

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Fleet.Telegram</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Fleet.Agent</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Fleet.Agent.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Fleet.Telegram.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fleet.Shared\Fleet.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Telegram.Bot" />
  </ItemGroup>

</Project>
