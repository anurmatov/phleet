{
  "name": "fleet-pi-extension",
  "version": "1.0.0",
  "private": true,
  "description": "Fleet's Pi extension: exact-name MCP bridge and prefix-reusing compaction (phleet #386)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@earendil-works/chord": "1.0.4",
    "@earendil-works/pi-agent-core": "1.0.4",
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-codemode": "1.0.4",
    "@earendil-works/pi-mcp": "1.0.4",
    "@earendil-works/pi-telemetry": "1.0.4",
    "@earendil-works/pi-tui": "1.0.4"
  }
}
