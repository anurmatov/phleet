<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.5" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Fleet.Conversations\Fleet.Conversations.csproj" />
    <!--
      The south listener and the `conversations` subcommands live in Fleet.Comms, and both need a
      real database to say anything: the south surface is the store's HTTP face, and a migration
      command with nothing to migrate against proves only that it parsed its arguments. So they are
      exercised HERE, in the one suite that has MySQL beside it, rather than in Fleet.Comms.Tests —
      which must keep running without a database.
    -->
    <ProjectReference Include="..\..\src\Fleet.Comms\Fleet.Comms.csproj" />
    <!--
      The round-trip suite (#303) is the one place where the agent half and the service half meet,
      and it needs both plus a real broker and a real database. It lives here rather than in
      Fleet.Agent.Tests because this is the project CI gives infrastructure to — and because a
      round trip asserted against a stubbed store is not a round trip.
    -->
    <ProjectReference Include="..\..\src\Fleet.Agent\Fleet.Agent.csproj" />
  </ItemGroup>

</Project>
