<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.5" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Fleet.Journal.Client\Fleet.Journal.Client.csproj" />
    <!--
      Referenced so a test can hand the record the drainer put on the wire to the REAL journal
      parser. `JournalRecordParser` is internal to Fleet.Comms and its `InternalsVisibleTo` names
      Fleet.Comms.Tests, so the seam is a public host method rather than a second test that
      re-implements the parser's rules and agrees with them by construction.
    -->
    <ProjectReference Include="..\..\src\Fleet.Comms\Fleet.Comms.csproj" />
  </ItemGroup>

</Project>
