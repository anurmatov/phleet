<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <!-- Drives the real /api/output-styles handlers over HTTP (#317 AC1-AC6). -->
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Provisioning output captured before #347 changed provisioning (ProjectContextGoldenTests). -->
    <None Update="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Fleet.Conversations\Fleet.Conversations.csproj" />
    <ProjectReference Include="..\..\src\Fleet.Journal.Client\Fleet.Journal.Client.csproj" />
    <ProjectReference Include="..\..\src\Fleet.Orchestrator\Fleet.Orchestrator.csproj" />
    <!-- #460 AC-X3: the effective-harness parity test binds the generated appsettings.json into the
         agent's own AgentOptions and builds the plan with the agent's own AgentHarness. Aliased, so
         the Fleet.Agent namespace never shadows the orchestrator's Agent entity in other tests. -->
    <ProjectReference Include="..\..\src\Fleet.Agent\Fleet.Agent.csproj" Aliases="FleetAgent" />
  </ItemGroup>

  <ItemGroup>
    <!-- The wire samples under tests/fixtures/wire and the helper that reads them. Shared source,
         not a shared assembly: each end of a pair is tested in a project that cannot see the other. -->
    <Compile Include="..\fixtures\wire\WireGolden.cs" Link="WireGolden.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The wire contracts are used throughout; see src/Fleet.Contracts. -->
    <Using Include="Fleet.Contracts" />
  </ItemGroup>

</Project>
